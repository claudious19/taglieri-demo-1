# Instagram-Benutzername, mit oder ohne @.
INSTAGRAM_USERNAME=robyWood

# Optionale Umami-Website-ID. Leer lassen, um Analytics auszuschalten.
UMAMI_WEBSITE_ID=9749b6c4-c64f-4d3f-998e-2d0d6280ae20
# Umami Cloud oder die URL einer eigenen Umami-Installation.
UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

PRICE_SMALL_CHF=45
PRICE_MEDIUM_CHF=80
PRICE_PIZZA_CHF=160
PRICE_LARGE_CHF=130

# Exakte Länge und Breite in cm. Beide Werte leer lassen, falls noch unbekannt.
