SIZE_SMALL_WIDTH_CM=
SIZE_MEDIUM_LENGTH_CM=
SIZE_MEDIUM_WIDTH_CM=
SIZE_PIZZA_LENGTH_CM=
SIZE_PIZZA_WIDTH_CM=
