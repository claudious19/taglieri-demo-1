# Öffentliche Website-Daten. Keine Passwörter oder geheimen Schlüssel eintragen.
PIECES_CREATED=200+
YEARS_EXPERIENCE=6+

# Empfänger der Formularanfragen. Die Adresse ist im öffentlichen Seitencode sichtbar.
